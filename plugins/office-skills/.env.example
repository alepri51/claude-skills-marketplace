# ── Yandex (ya-tracker, ya-wiki) ──────────────────────────────────────────
YANDEX_TOKEN=
YANDEX_ORG_ID=
# Если используется Yandex Cloud Org вместо обычного:
# YANDEX_CLOUD_ORG_ID=

# Опционально:
# TRACKER_BASE_URL=https://api.tracker.yandex.net
# TRACKER_DOWNLOAD_DIR=./.tracker-downloads
# WIKI_BASE_URL=https://wiki-api.yandex-team.ru
# WIKI_DOWNLOAD_DIR=./.wiki-downloads

# ── DB connections (db-universal) ─────────────────────────────────────────
# Имена переменных — произвольные, но должны совпадать с ${...} в
# skills/db-universal/config/connections.json.
# Пример для одной БД "parsing-dev":
DB_PARSING_DEV_HOST=
DB_PARSING_DEV_PORT=3306
DB_PARSING_DEV_USER=
DB_PARSING_DEV_PASSWORD=
DB_PARSING_DEV_NAME=
# DB_PARSING_DEV_TYPE=mysql

# Generic fallback (если работаешь без connections.json):
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_TYPE=mysql
